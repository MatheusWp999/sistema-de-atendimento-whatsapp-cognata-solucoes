  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-local.ps1",
    "conversations:dedupe": "tsx scripts/dedupe-conversations.ts",
    "conversations:backfill-aliases": "tsx scripts/backfill-conversation-aliases.ts",
