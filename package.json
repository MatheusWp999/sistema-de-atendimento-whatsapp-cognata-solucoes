    "worker:outbound": "tsx scripts/process-outbound-messages.ts",
    "worker:outbound:once": "tsx scripts/process-outbound-messages.ts --once",
    "worker:inbound": "tsx scripts/process-inbound-events.ts",
    "worker:inbound:once": "tsx scripts/process-inbound-events.ts --once",
    "worker:summary": "tsx scripts/process-conversation-summaries.ts",
    "worker:summary:once": "tsx scripts/process-conversation-summaries.ts --once",
    "worker:whatsapp": "tsx scripts/run-whatsapp-worker.ts",
    "retention:cleanup": "tsx scripts/retention-cleanup.ts",
