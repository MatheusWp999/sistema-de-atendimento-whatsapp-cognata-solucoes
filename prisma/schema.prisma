generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                        String    @id @default(cuid())
  name                      String
  whatsappNumber            String?
  whatsappSessionEnabled    Boolean   @default(false)
  whatsappConnectionStatus  String    @default("DISCONNECTED")
  whatsappConnectedAt       DateTime?
  whatsappLastSeenAt        DateTime?
  whatsappLastError         String?
  whatsappPhoneNumberId     String?   @unique
  whatsappQrCodeDataUrl     String?
  whatsappQrCodeUpdatedAt   DateTime?
  description               String?
  accountStatus             String    @default("APPROVED")
  planKey                   String?
  planApprovedAt            DateTime?
  planApprovedByUserId      String?
  aiEnabled                 Boolean   @default(true)
  businessHours             Json?
  notes                     String?
  aiProvider                String    @default("openai")
  useOwnOpenAiKey           Boolean   @default(false)
  openAiApiKeyEncrypted     String?
  useOwnOpenRouterKey       Boolean   @default(false)
  openRouterApiKeyEncrypted String?
  openRouterModel           String?
  defaultAiModel            String?
  fallbackAiModel           String?
  embeddingModel            String?
  dailyMessageLimit         Int?
  monthlyMessageLimit       Int?
  dailyCostLimit            Float?
  monthlyCostLimit          Float?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  assistant                  Assistant?
  conversations              Conversation[]
  memberships                CompanyMembership[]
  knowledgeItems             KnowledgeItem[]
  usageLogs                  AIUsageLog[]
  deliveryAttempts           MessageDeliveryAttempt[]
  summaryJobs                ConversationSummaryJob[]
  companyModules             CompanyModule[]
  conversationModuleStates   ConversationModuleState[]
  restaurantOrders           RestaurantOrder[]
  conversationContactAliases ConversationContactAlias[]
  inboundEvents              InboundEvent[]
  auditLogs                  AuditLog[]
  whatsappSessionCommands    WhatsAppSessionCommand[]
  whatsappTemplates          WhatsAppTemplate[]
  campaigns                  Campaign[]
  campaignRecipients         CampaignRecipient[]
  automationRules            AutomationRule[]
  automationRuns             AutomationRun[]
  webhookEndpoints           WebhookEndpoint[]
  webhookDeliveries          WebhookDelivery[]
  aiGovernanceLogs           AIGovernanceLog[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         String    @default("OPERATOR")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships           CompanyMembership[]
  assignedConversations Conversation[]      @relation("AssignedConversations")
  passwordResetTokens    PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("OPERATOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
}

model Assistant {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  name                 String
  role                 String?
  personality          String
  tone                 String?
  greetingMessage      String?
  closingMessage       String?
  formalityLevel       Int      @default(3)
  friendlinessLevel    Int      @default(3)
  objectivityLevel     Int      @default(3)
  commercialLevel      Int      @default(3)
  detailLevel          Int      @default(3)
  responseSize         String   @default("medium")
  useEmojis            Boolean  @default(false)
  temperature          Float    @default(0.4)
  maxTokens            Int      @default(700)
  mandatoryRules       String?
  forbiddenRules       String?
  humanEscalationRules String?
  fallbackMessage      String?
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                    String    @id @default(cuid())
  companyId             String
  customerName          String?
  customerPhone         String
  aiStatus              String    @default("AI_ACTIVE")
  currentOwner          String    @default("AI")
  supportStatus         String    @default("OPEN")
  priority              String    @default("normal")
  assignedUserId        String?
  assignedAt            DateTime?
  slaDueAt              DateTime?
  ownerEpoch            Int       @default(0)
  lastMessage           String?
  lastMessageAt         DateTime?
  lastCustomerMessageAt DateTime?
  unreadCount           Int       @default(0)
  lastReadAt            DateTime?
  tags                  String[]  @default([])
  internalNotes         String?
  aiSummary             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedUser     User?                      @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages         Message[]
  usageLogs        AIUsageLog[]
  deliveryAttempts MessageDeliveryAttempt[]
  summaryJobs      ConversationSummaryJob[]
  moduleStates     ConversationModuleState[]
  restaurantOrders RestaurantOrder[]
  contactAliases   ConversationContactAlias[]
  campaignRecipients CampaignRecipient[]
  automationRuns      AutomationRun[]
  aiGovernanceLogs    AIGovernanceLog[]

  @@unique([companyId, customerPhone])
  @@index([companyId, lastMessageAt])
  @@index([companyId, aiStatus, lastMessageAt])
  @@index([companyId, supportStatus, slaDueAt])
  @@index([assignedUserId, supportStatus])
  @@index([aiStatus, currentOwner])
}

model ConversationSummaryJob {
  id             String    @id @default(cuid())
  conversationId String
  companyId      String
  status         String    @default("queued")
  force          Boolean   @default(false)
  attempts       Int       @default(0)
  lockedBy       String?
  leaseExpiresAt DateTime?
  errorMessage   String?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
  @@index([conversationId, status])
  @@index([companyId, status])
}

model ConversationContactAlias {
  id             String   @id @default(cuid())
  companyId      String
  conversationId String
  alias          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([companyId, alias])
  @@index([conversationId])
}

model CompanyModule {
  id        String   @id @default(cuid())
  companyId String
  moduleKey String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleKey])
  @@index([companyId, enabled])
}

model ConversationModuleState {
  id             String   @id @default(cuid())
  companyId      String
  conversationId String
  moduleKey      String
  status         String
  currentStep    String?
  collectedData  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, moduleKey])
  @@index([companyId, moduleKey, status])
}

model RestaurantOrder {
  id              String    @id @default(cuid())
  companyId       String
  conversationId  String
  customerName    String?
  customerPhone   String
  fulfillmentType String
  address         String?
  paymentMethod   String?
  notes           String?
  status          String    @default("confirmed")
  subtotal        Decimal?  @db.Decimal(12, 2)
  deliveryFee     Decimal?  @db.Decimal(12, 2)
  total           Decimal?  @db.Decimal(12, 2)
  rawData         Json?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  items        RestaurantOrderItem[]

  @@index([companyId, status, createdAt])
  @@index([conversationId, createdAt])
}

model RestaurantOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  quantity  Int      @default(1)
  unitPrice Decimal? @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Message {
  id                  String    @id @default(cuid())
  externalId          String?   @unique
  conversationId      String
  companyId           String
  senderType          String
  content             String
  messageType         String    @default("text")
  status              String    @default("sent")
  origin              String
  metadata            Json?
  claimedAt           DateTime?
  claimedBy           String?
  claimToken          String?
  leaseExpiresAt      DateTime?
  nextAttemptAt       DateTime?
  responseToMessageId String?
  idempotencyKey      String?
  createdAt           DateTime  @default(now())

  conversation     Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveryAttempts MessageDeliveryAttempt[]
  aiGovernanceLogs AIGovernanceLog[]

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([conversationId, senderType, createdAt])
  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model MessageDeliveryAttempt {
  id             String    @id @default(cuid())
  messageId      String
  conversationId String
  companyId      String
  provider       String
  attemptNumber  Int
  status         String
  externalId     String?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([messageId, attemptNumber])
  @@index([messageId, attemptNumber])
  @@index([companyId, status, startedAt])
  @@index([conversationId, startedAt])
}

model KnowledgeItem {
  id         String   @id @default(cuid())
  companyId  String
  title      String
  type       String
  content    String?
  filePath   String?
  sourceType String
  active     Boolean  @default(true)
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]

  @@index([companyId, active])
}

model KnowledgeChunk {
  id               String                 @id @default(cuid())
  knowledgeItemId  String
  companyId        String
  content          String
  chunkIndex       Int
  tokenCount       Int?
  embedding        Unsupported("vector")?
  embeddingModel   String?
  embeddingVersion String?
  createdAt        DateTime               @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, chunkIndex])
  @@index([companyId])
  @@index([knowledgeItemId])
}

model AIUsageLog {
  id             String   @id @default(cuid())
  companyId      String
  conversationId String?
  provider       String   @default("openai")
  model          String
  embeddingModel String?
  usedCompanyKey Boolean  @default(false)
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  estimatedCost  Float?
  requestType    String
  status         String
  errorMessage   String?
  createdAt      DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([requestType, status])
}

model AIGovernanceLog {
  id                 String   @id @default(cuid())
  companyId          String
  conversationId     String?
  messageId          String?
  provider           String
  model              String
  promptPreview      String?
  responsePreview    String?
  retrievedKnowledge Json?
  fallbackUsed       Boolean  @default(false)
  needsHumanReview   Boolean  @default(false)
  status             String
  errorMessage       String?
  latencyMs          Int?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  createdAt          DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model WhatsAppTemplate {
  id                 String   @id @default(cuid())
  companyId          String
  name               String
  category           String   @default("MARKETING")
  language           String   @default("pt_BR")
  status             String   @default("DRAFT")
  body               String
  variables          String[] @default([])
  providerTemplateId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model Campaign {
  id              String    @id @default(cuid())
  companyId       String
  templateId      String?
  name            String
  status          String    @default("DRAFT")
  audience        Json?
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template   WhatsAppTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([companyId, status, scheduledAt])
  @@index([templateId])
}

model CampaignRecipient {
  id             String    @id @default(cuid())
  companyId      String
  campaignId     String
  conversationId String?
  phone          String
  name           String?
  status         String    @default("PENDING")
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([companyId, status, createdAt])
  @@index([conversationId])
}

model AutomationRule {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  triggerKey    String
  enabled       Boolean  @default(true)
  delayMinutes  Int      @default(60)
  conditions    Json?
  actionKey     String   @default("SEND_MESSAGE")
  actionPayload Json?
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    AutomationRun[]

  @@index([companyId, enabled, triggerKey])
}

model AutomationRun {
  id             String   @id @default(cuid())
  companyId      String
  ruleId         String
  conversationId String?
  status         String
  message        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([ruleId, createdAt])
  @@index([conversationId, createdAt])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  url             String
  events          String[]  @default([])
  active          Boolean   @default(true)
  secretEncrypted String?
  lastDeliveryAt  DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId, active])
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  companyId    String
  endpointId   String
  event        String
  entityType   String?
  entityId     String?
  payload      Json
  status       String    @default("queued")
  attempts     Int       @default(0)
  httpStatus   Int?
  responseBody String?
  errorMessage String?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([endpointId, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InboundEvent {
  id                String    @id @default(cuid())
  provider          String
  providerAccountId String?
  externalId        String
  companyId         String?
  payload           Json
  status            String    @default("queued")
  attempts          Int       @default(0)
  lockedBy          String?
  leaseExpiresAt    DateTime?
  errorMessage      String?
  receivedAt        DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@index([status, leaseExpiresAt])
  @@index([companyId, receivedAt])
}

model WhatsAppSessionCommand {
  id             String    @id @default(cuid())
  companyId      String
  action         String
  status         String    @default("queued")
  payload        Json?
  requestedBy    String?
  lockedBy       String?
  leaseExpiresAt DateTime?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([companyId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  companyId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
